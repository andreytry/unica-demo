                "jsCode": "var b = $json.body || $json;\nfunction v(k){ return (b[k]!==undefined && b[k]!==null) ? String(b[k]) : \"\"; }\nvar label = (\"Schaden \" + v(\"loss_type\") + \" \" + v(\"policy_number\") + \" \" + v(\"full_name\")).trim().slice(0,128);\nvar desc = [\"SCHADENMELDUNG (V+ Versicherung)\",\"Policy: \"+v(\"policy_number\"),\"Name: \"+v(\"full_name\"),\"Phone: \"+v(\"phone\"),\"Email: \"+v(\"email\"),\"Schadenart: \"+v(\"loss_type\"),\"Schadendatum: \"+v(\"date_of_loss\"),\"Ort: \"+v(\"location\"),\"Hergang: \"+v(\"description\"),\"Verletzte: \"+v(\"injuries\"),\"Dritte beteiligt: \"+v(\"third_party\"),\"Geschaetzter Betrag: \"+v(\"estimated_amount\")].join(\"\\n\");\nvar pega = { caseTypeID: \"MyOrg-CILMConv-Work-Claim\", content: { pyLabel: label, pyDescription: desc } };\nreturn [{ json: { pega: pega } }];"
            },
