            "parameters": {
                "jsCode": "const root = $input.first().json;\nconst analysis = root.analysis || (root.body && root.body.analysis) || {};\nconst dcr = analysis.data_collection_results || {};\nconst g = (k) => { const f = dcr[k]; if(!f) return ''; const v = (f.value!==undefined? f.value : f); return (v===null||v===undefined)? '' : v; };\nconst lob = String(g('line_of_business')).toLowerCase();\nconst map = { car:'MyOrg-CILMConv-Work-LeadCar', auto:'MyOrg-CILMConv-Work-LeadCar', liability:'MyOrg-CILMConv-Work-LeadLiability', home:'MyOrg-CILMConv-Work-LeadHomeContents', home_contents:'MyOrg-CILMConv-Work-LeadHomeContents', legal:'MyOrg-CILMConv-Work-LeadLegal', life:'MyOrg-CILMConv-Work-LeadLife' };\nconst caseTypeID = map[lob] || 'MyOrg-CILMConv-Work-LeadIntake';\nconst fullName=g('full_name'); const email=g('email'); const phone=g('mobile_phone')||g('phone'); const postalCode=g('postal_code'); const summary=g('conversation_summary'); const quote=g('indicative_quote');\nconst label='Lead: '+(fullName||'Unknown')+' - '+(lob||'n/a')+(phone?' - '+phone:'');\nconst d=[]; if(email)d.push('Email '+email); if(postalCode)d.push('PLZ '+postalCode); if(quote)d.push('Quote '+quote); if(summary)d.push(summary); d.push('via Unica voice (E2E)');\nconst description=d.join('; ');\nreturn [{ json: { caseTypeID, fullName, email, phone, postalCode, lineOfBusiness: lob, label, description } }];",
                "language": "javaScript"
            },
            "typeVersion": 2
        },
