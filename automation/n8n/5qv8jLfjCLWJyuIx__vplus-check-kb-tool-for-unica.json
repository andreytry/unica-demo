            "parameters": {
                "mode": "runOnceForAllItems",
                "jsCode": "\nvar kbr = $('KB Content').first().json;\nvar kbBody = (kbr.body!==undefined? kbr.body : kbr);\nvar kbText = (typeof kbBody === \"string\") ? kbBody : JSON.stringify(kbBody);\nvar kbHasUnica = kbText.indexOf(\"Unica\")>=0 || kbText.indexOf(\"UNICA\")>=0 || kbText.indexOf(\"unica\")>=0;\nvar unicaCount = (kbText.match(/Unica/gi)||[]).length;\nvar t = $json; var tb = (t.body!==undefined? t.body : t);\nreturn [{ json: { kb_status:(kbr.statusCode!==undefined?kbr.statusCode:null), kb_len: kbText.length, kb_has_unica: kbHasUnica, kb_unica_count: unicaCount, kb_head: kbText.slice(0,400), tool_status:(t.statusCode!==undefined?t.statusCode:null), tool_body: tb } }];\n"
            },
